    {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Draft\nRegistered\nDeposited\nCleared\nBounced\nCancelled","default":"Draft","read_only":1,"in_list_view":1,"in_standard_filter":1,"bold":1},
    {"fieldname":"col_break_1","fieldtype":"Column Break"},
    {"fieldname":"company","fieldtype":"Link","label":"Company","options":"Company","reqd":1},
    {"fieldname":"currency","fieldtype":"Link","label":"Currency","options":"Currency","reqd":1},

    {"fieldname":"section_party","fieldtype":"Section Break","label":"Party Information"},
