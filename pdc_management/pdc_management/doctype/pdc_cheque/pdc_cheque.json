    {"fieldname":"notification_sent","fieldtype":"Check","label":"Maturity Notification Sent","read_only":1},
    {"fieldname":"col_break_6","fieldtype":"Column Break"},
    {"fieldname":"notify_email","fieldtype":"Data","label":"Notify Email"},
    {"fieldname":"last_notification_date","fieldtype":"Date","label":"Last Notification Sent On","read_only":1}

