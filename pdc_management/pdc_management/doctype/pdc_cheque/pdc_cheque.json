    {"fieldname":"section_reference","fieldtype":"Section Break","label":"Invoice References"},
    {"fieldname":"references","fieldtype":"Table","label":"Invoice References","options":"PDC Cheque Invoice"},
    {"fieldname":"remarks","fieldtype":"Small Text","label":"Remarks"},

    {"fieldname":"section_dates","fieldtype":"Section Break","label":"Transaction Dates","collapsible":1},
    {"fieldname":"deposit_date","fieldtype":"Date","label":"Deposit Date","read_only":1},
    {"fieldname":"clearance_date","fieldtype":"Date","label":"Clearance Date","read_only":1},
    {"fieldname":"bounce_date","fieldtype":"Date","label":"Bounce Date","read_only":1},
    {"fieldname":"col_break_5","fieldtype":"Column Break"},
    {"fieldname":"journal_entry","fieldtype":"Link","label":"Deposit Journal Entry","options":"Journal Entry","read_only":1},
    {"fieldname":"clearance_journal_entry","fieldtype":"Link","label":"Clearance Journal Entry","options":"Journal Entry","read_only":1},
    {"fieldname":"bounce_journal_entry","fieldtype":"Link","label":"Bounce Journal Entry","options":"Journal Entry","read_only":1},

    {"fieldname":"section_notify","fieldtype":"Section Break","label":"Notifications","collapsible":1},
