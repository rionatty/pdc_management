    {"fieldname":"party","fieldtype":"Dynamic Link","label":"Party","options":"party_type","reqd":1,"in_list_view":1,"in_standard_filter":1,"bold":1},
    {"fieldname":"customer_name","fieldtype":"Data","label":"Customer Name","read_only":1},
    {"fieldname":"col_break_2","fieldtype":"Column Break"},
