  "permissions": [
    {"role":"Accounts Manager","read":1,"write":1,"create":1,"delete":1,"submit":1,"cancel":1,"amend":1,"print":1,"report":1,"email":1},
    {"role":"Accounts User","read":1,"write":1,"create":1,"submit":1,"print":1,"report":1,"email":1},
