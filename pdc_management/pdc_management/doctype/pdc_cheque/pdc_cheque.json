    {"fieldname":"section_bank","fieldtype":"Section Break","label":"Bank Information"},
    {"fieldname":"bank_name","fieldtype":"Data","label":"Drawer Bank Name","reqd":1},
    {"fieldname":"bank_branch","fieldtype":"Data","label":"Bank Branch"},
